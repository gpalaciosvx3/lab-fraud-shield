{
  "name": "fraud-shield",
  "version": "1.0.0",
  "description": "Detector de fraude en tiempo real",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "jest --coverage",
    "local:ingest": "ts-node local-test/ingest-transaction.runner.ts",
    "local:seed": "npm run local:seed:profiles && npm run local:seed:rules",
    "local:seed:profiles": "ts-node local-test/seed-client-profiles.awslocal.runner.ts",
    "local:seed:rules": "ts-node local-test/seed-fraud-rules.awslocal.runner.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-kinesis": "^3.1046.0",
    "@aws-sdk/client-sns": "^3.937.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.140",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.37",
    "dotenv": "^16.4.0",
    "jest": "^29.7.0",
    "jest-cucumber": "^4.4.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
